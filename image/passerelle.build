# SPDX-License-Identifier: Apache-2.0
#
# image/passerelle.build - IFS build file fragment for the Passerelle guest.
#
# This is a *fragment*: it is meant to be included by the build file of the
# image the guest boots from (see image/README.md). It declares the files the
# guest needs and nothing else:
#
#   - the kernel and the C library (QNX-02: no dependency beyond those and the
#     PCI server);
#   - the PCI server and its configuration, so the virtio device is found;
#   - the two drivers, fs9p and fsfuse;
#   - the start-up script that mounts the share.
#
# QNX SDP 8.0 layout (measured on the SDP's own qemu guest, tests/qemu/qnx8/):
# the IFS of a `-kernel` guest is mounted on /proc/boot and its files land
# *flat* there - the binaries, the shared objects and the PCI modules all live
# under /proc/boot, not under bin/, lib/ or usr/lib/. PATH and LD_LIBRARY_PATH
# therefore point at /proc/boot, and the only absolute path that must still
# exist is the interpreter the programs name, /usr/lib/ldqnx-64.so.2, which the
# start-up script links onto /proc/boot/ldqnx-64.so.2.
#
# DX-01: `qshare` on the PC prints the QEMU options and the fragment that
# embeds the driver and mounts the share at boot (the fragment is this file).
# DX-06: the image contains only the kernel, the PCI server and the driver; the
# root of the guest stays on the share.

[image=20m]
[virtual=x86_64,multiboot] boot = {
    # startup-x86 is the variant the SDP 8.0 uses for its own QEMU guest
    # (host/common/mkqnximage/inputs/ifs.build); startup-apic is kept in the
    # fragment's history but is not the one the SDP boots.
    startup-x86 -D8250..115200 -zz

    PATH=/proc/boot
    CONFIG_PATH=/proc/boot
    LD_LIBRARY_PATH=/proc/boot

    [+keeplinked uid=0 gid=0 perms=0700] procnto-smp-instr -mr -d 0777 -u 0777
}

[+script] startup-script = {
    # The loader lives at /proc/boot/ldqnx-64.so.2; the absolute interpreter
    # path the binaries declare is /usr/lib/ldqnx-64.so.2 (QNX-02).
    procmgr_symlink /proc/boot/ldqnx-64.so.2 /usr/lib/ldqnx-64.so.2
    # The scripts are shebanged #!/bin/sh; the shell lives flat at /proc/boot/sh.
    procmgr_symlink /proc/boot/sh /bin/sh
    # getpwnam() reads /etc/passwd: the account the driver drops root to
    # (QNX-06) is declared in the image at /proc/boot/passwd.
    procmgr_symlink /proc/boot/passwd /etc/passwd

    display_msg "Passerelle: starting the PCI services"
    slogger2

    devc-ser8250 -e
    waitfor /dev/ser1
    reopen /dev/ser1

    # The PCI server is the only service the drivers need (QNX-02): it owns
    # the virtio device and hands the interrupt line over.
    PCI_HW_MODULE=pci_hw-Intel_x86.so
    PCI_BKWD_COMPAT_MODULE=pci_bkwd_compat.so
    PCI_SLOG_MODULE=pci_slog2.so
    PCI_CAP_MODULE_DIR=/proc/boot
    PCI_BASE_VERBOSITY=3
    PGW_LOG_LEVEL=info

    display_msg "Passerelle: starting PCI Services"
    pci-server --config=/proc/boot/pci_server.cfg

    # DX-01 proof: print what QNX sees on the PCI bus so the operator can
    # confirm the virtio-9p device (vid/did 1af4/1009) without a debugger.
    # What the guest answers for the two calls the deadlines are built on.
    /proc/boot/clockprobe

    display_msg "Passerelle: PCI bus inventory"
    pci-tool -v

    [+session] sh &

    # The share is mounted here: the script waits for the device, mounts it and
    # writes to the system log (QNX-07, QNX-08). The driver creates the mount
    # point directory itself when the system lets it.
    /proc/boot/qshare-mount.sh &

    display_msg "Passerelle: startup complete"
}

#############################################
### PCI
#############################################

[perms=0444] pci_server.cfg = {
[buscfg]
DO_BUS_CONFIG=no

[envars]
PCI_DEBUG_MODULE=pci_debug2.so
PCI_HW_MODULE=pci_hw-Intel_x86.so
PCI_HW_CONFIG_FILE=/proc/boot/pci_hw.cfg
}

[perms=0444] pci_hw.cfg = {
[interrupts]
# The virtio-9p device, pinned to slot 5 with `-device virtio-9p-pci,...,addr=0x05`.
# QEMU (SeaBIOS, i440fx `pc` machine) routes slot 5 pin A to IRQ 10 - measured
# with `info pci`, see tests/qemu/qnx8/README.md. Kept alongside the SDP 8.0
# defaults (device 17 and bus 3) for the peripherals of the reference image.
B0:D5:F0     A    10
B0:D17:F0    A    18
B0:D17:F0    B    19
B0:D17:F0    C    16
B0:D17:F0    D    17
B3:D0:F0     A    18
B3:D0:F0     B    19
B3:D0:F0     C    16
B3:D0:F0     D    17
}

# Libraries, flat in /proc/boot like the SDP 8.0 reference image.
ldqnx-64.so.2=ldqnx-64.so.2
libc.so.6=libc.so.6
libm.so.3=libm.so.3
libgcc_s.so.1=libgcc_s.so.1
libpci.so.3.0=libpci.so.3.0
libsecpol.so.1=libsecpol.so.1
libslog2.so.1=libslog2.so.1
libslog2parse.so.1=libslog2parse.so.1
libfsnotify.so.1=libfsnotify.so.1
libtracelog.so.1=libtracelog.so.1
libz.so.2=libz.so.2
pci_bkwd_compat.so=pci/pci_bkwd_compat.so
pci_cap-0x05.so=pci/pci_cap-0x05.so
pci_cap-0x01.so=pci/pci_cap-0x01.so
pci_cap-0x09-1af4ffff.so=pci/pci_cap-0x09-ffffffff.so
pci_cap-0x10.so=pci/pci_cap-0x10.so
pci_cap-0x11.so=pci/pci_cap-0x11.so
pci_debug2.so=pci/pci_debug2.so
pci_hw-Intel_x86.so=pci/pci_hw-Intel_x86.so
pci_slog2.so=pci/pci_slog2.so
pci_strings.so=pci/pci_strings.so

# Binaries, flat in /proc/boot.
devc-ser8250=devc-ser8250
pci-server=pci-server
pci-tool=pci-tool
pidin=pidin
sh=sh
slay=slay
shutdown=shutdown
slog2info=slog2info
slogger2=slogger2
toybox=toybox
tracelogger=tracelogger
traceprinter=traceprinter

[type=link] cat=toybox
[type=link] chmod=toybox
[type=link] grep=toybox
[type=link] head=toybox
[type=link] ls=toybox
[type=link] mkdir=toybox
[type=link] rm=toybox
[type=link] sleep=toybox
[type=link] uname=toybox

# The drivers and the mount script. The drivers are built by the other half of
# the project (drivers/); until they exist the three entries are skipped, and
# the image still boots with the kernel, the C library and the PCI server.
[+optional] clockprobe=clockprobe
[+optional] mapprobe=mapprobe
[+optional] qbench=qbench
[+optional] fs9p=fs9p
[+optional] fsfuse=fsfuse
[+optional] qshare-mount.sh=qshare-mount.sh
[+optional] qtrace.sh=qtrace.sh

# The account the drivers drop root to (QNX-06): it exists only to own the
# mount point and the device, it has no shell rights.
passwd = {
root::0:0:root:/root:/bin/sh
passerelle::200:200:passerelle:/tmp:/bin/sh
}